# LINE Messaging API（LINE Developers コンソールで取得）
# コピーして .env として使うか、export してください。
# 未設定のまま起動するとデモ／モックモードになります（実送信しません）。
#
# 【販売時の前提】
# - 使うのは「お客様（店舗）の LINE 公式アカウント」の Channel secret / token
# - 開発者個人の LINE アカウントは不要
# - スタッフは公式を友だち追加 →「登録 <店舗コード>」で紐付け

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 単一宛先プッシュ用（任意）。マルチテナントでは店舗の line_user_ids[] を使う
LINE_USER_ID=

# webhook サーバ
LINE_WEBHOOK_HOST=0.0.0.0
LINE_WEBHOOK_PORT=8080

# true / 1 で強制デモモード（トークンがあっても実 API を呼ばない）
LINE_DEMO_MODE=false

# 店舗レジストリ（JSON）。未指定時は line_bridge/stores.json
# LINE_STORES_PATH=./stores.json

# 招待リンクのベース（QR プレースホルダ用）。本番は公式の友だち追加 URL に差し替え
# LINE_INVITE_BASE_URL=https://line.me/R/ti/p/@YOUR_OFFICIAL_ACCOUNT

# 未登録ユーザーに希望休／シフトを拒否する（既定 true）
# LINE_REQUIRE_REGISTER=true
# 未登録でも orphan シナリオで動かす（ローカル実験用）
# LINE_ALLOW_ORPHAN=false

# シフトソルバ用（任意）。未指定時は community_mina の既定シナリオ
# LINE_SCENARIO_JSON=../shift_scenario_tiny.json

# 全店舗一覧 GET /stores 用管理トークン（未設定時は /stores を 403）
# LINE_STORES_ADMIN_TOKEN=change-me-long-random

# 店長昇格用オーナーコード（任意。既存店に外部から店長を足すとき）
# LINE_STORE_OWNER_CODE=

# ---- Monetization (Payment Provider; NOT LINE Mini App IAP subscriptions) ----
# LINE IAP is consumable-only. Recurring plans use external checkout + webhook.
# PAYMENT_PROVIDER=mock
# PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
# PAYMENT_WEBHOOK_SECRET=change-me-long-random
# PAYMENT_ALLOW_UNSIGNED_WEBHOOK=false
# Stripe (optional; set PAYMENT_PROVIDER=stripe)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STANDARD=price_xxx
# STRIPE_PRICE_PRO=price_xxx
